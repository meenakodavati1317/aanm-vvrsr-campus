# Copy this file to .env and edit the values.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/aanm_vvrsr_campus
JWT_SECRET=change-this-to-a-long-random-string
# Password given to students and faculty that an admin adds directly (and to seeded demo accounts).
DEFAULT_PASSWORD=demo1234
# Admins who sign up with this invite code are marked "valid invite code" for the approver.
ADMIN_INVITE_CODE=AV-2026
# Academic year the sample data and new roll numbers are based on.
CURRENT_YEAR=2026
# Largest photo or video an admin can upload, in megabytes.
MAX_UPLOAD_MB=100
# Optional: comma separated list of allowed origins if the frontend is hosted elsewhere.
# CORS_ORIGIN=http://localhost:5173
